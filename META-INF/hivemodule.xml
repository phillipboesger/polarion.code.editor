<?xml version="1.0" encoding="UTF-8"?>
<module id="boesger.polarion.codeeditor" version="1.0.0">

	<contribution configuration-id="com.polarion.xray.webui.administrationPageExtenders">
		<extender id="code-editor" name="Code Editor" iconUrl="/polarion/code-editor/resources/img/code-editor-icon.svg" pageUrl="/polarion/code-editor/editor.html" projectScope="true" projectGroupScope="true" repositoryScope="true" />
	</contribution>

	<!--
		The custom sidebar navigation entry previously registered here extended
		com.polarion.alm.ui.server.navigation.NavigationExtender, which Polarion
		2606 removed.  On 2606 HiveMind aborts the whole module with a FATAL when
		it cannot resolve that interface, which also prevents this bundle's
		com.polarion.portal.tomcat.webapps contribution (the editor webapp) from
		being registered.  The Code Editor is reached via the administration page
		extender above on every supported platform, so the redundant custom
		extender is dropped to keep the bundle loading cleanly on 2512 and 2606.
	-->

	<!--
		Registers the two custom Code Editor permissions with Polarion's security framework.
		The GenericPermissionFactory constructs a plain com.polarion.platform.security.Permission
		for any id under the "boesger.codeeditor" prefix (boesger.codeeditor.read / .write), which
		lets ISecurityService.constructPermission(...) resolve them and hasPermission(...) evaluate
		grants/denies stored in .polarion/security/permissions.xml with native global->project
		inheritance. Without this contribution constructPermission throws and access cannot be checked.
	-->
	<service-point id="CodeEditorPermissionFactory" interface="com.polarion.platform.spi.security.IPermissionFactory">
		<invoke-factory>
			<construct class="com.polarion.platform.spi.security.GenericPermissionFactory">
				<set-object property="permissionClass" value="class:com.polarion.platform.security.Permission"/>
				<set property="description" value="Code Editor plugin access: 'boesger.codeeditor.read' (browse and open files), 'boesger.codeeditor.write' (create, modify, rename and delete files)."/>
			</construct>
		</invoke-factory>
	</service-point>

	<contribution configuration-id="com.polarion.platform.security.permissionFactories">
		<factory prefix="boesger.codeeditor" service="CodeEditorPermissionFactory"/>
	</contribution>

</module>
