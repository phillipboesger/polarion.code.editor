<project xmlns="http://maven.apache.org/POM/4.0.0"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>boesger.polarion</groupId>
  <artifactId>code-editor</artifactId>
  <version>1.5.1</version>
  <packaging>jar</packaging>

  <name>Polarion Code Editor Plugin</name>
  <description>Comprehensive Code Editor for Polarion Administration.</description>
  <url>https://github.com/phillipboesger/polarion.code.editor</url>

  <organization>
    <name>Bösger</name>
    <url>https://digital.boesger.com</url>
  </organization>

  <scm>
    <connection>scm:git:https://github.com/phillipboesger/polarion.code.editor.git</connection>
    <developerConnection>scm:git:https://github.com/phillipboesger/polarion.code.editor.git</developerConnection>
    <url>https://github.com/phillipboesger/polarion.code.editor</url>
    <tag>HEAD</tag>
  </scm>

  <!--
    Polarion platform JARs are consumed from our own private GitHub Packages
    Maven mirror (phillipboesger/polarion-ootb-plugins), which republishes every
    OOTB Polarion bundle straight from a licensed install ZIP. Coordinates follow
    the OSGi bundle: groupId "com.polarion", artifactId = Bundle-SymbolicName with
    the leading "com.polarion." stripped, version = Bundle-Version (e.g. 3.25.12).
    CI authenticates via the PACKAGES_TOKEN secret (PAT with read:packages).
    The server id "github" is injected by actions/setup-java in the CI workflow.
  -->
  <repositories>
    <repository>
      <id>github</id>
      <url>https://maven.pkg.github.com/phillipboesger/polarion-ootb-plugins</url>
      <snapshots>
        <enabled>true</enabled>
      </snapshots>
    </repository>
  </repositories>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
    <maven.compiler.release>21</maven.compiler.release>
    <!-- OSGi Bundle-Version must not contain SNAPSHOT; keep in sync with project.version -->
    <manifest.version>1.5.1</manifest.version>

    <!--
      DUAL-PLATFORM BUILD (Polarion 2512 *and* 2606) — single source tree

      Polarion 2606 upgraded the embedded servlet container from Tomcat 9
      (Jakarta EE 8, javax.servlet) to Tomcat 11 (Jakarta EE 11, jakarta.servlet,
      Servlet 6.1). Sources stay javax.servlet-only (see CodeEditorServlet.java
      and src/main/webapp/WEB-INF/web.xml); org.eclipse.transformer:transformer-maven-plugin
      rewrites the compiled bytecode + web.xml at build time to produce a jakarta
      sibling jar. A maven-antrun-plugin step then renames the two build outputs
      so the *default* (no-classifier) jar is the 2606/jakarta build and the
      legacy javax build carries a -pre2606 suffix — 2606 is the primary target
      going forward; the -pre2606 jar exists only for the Polarion 2512 transition
      window and will be dropped once those installs are retired:

        * boesger.polarion.code-editor-<ver>.jar          -> Polarion 2606 (jakarta, default)
        * boesger.polarion.code-editor-<ver>-pre2606.jar  -> Polarion 2512 (javax, legacy)

      Both variants compile against the SAME, namespace-stable Polarion platform
      API below (3.25.12). Those APIs are forward-compatible and the OSGi
      Require-Bundle version acts as a *minimum* floor, so the 2606 JAR resolves
      cleanly against the higher 3.26.6 bundles at runtime.
    -->
    <!-- Polarion platform version used for OSGi Require-Bundle and compilation -->
    <polarion.version>3.25.12</polarion.version>
    <!-- subterra versioning follows a separate scheme; 5.25.12 aligns with 3.25.12 -->
    <subterra.version>5.25.12</subterra.version>
  </properties>

  <!-- Top-level (not plugin-scoped) so ${project.build.finalName} resolves to the
       real on-disk jar name everywhere it's referenced below, including in the
       transformer-maven-plugin and maven-antrun-plugin executions. -->
  <build>
    <finalName>${project.groupId}.${project.artifactId}-${project.version}</finalName>

    <resources>
      <resource>
        <directory>META-INF</directory>
        <includes>
          <include>hivemodule.xml</include>
        </includes>
        <targetPath>META-INF</targetPath>
      </resource>
      <resource>
        <directory>src/main/webapp</directory>
        <targetPath>src/main/webapp</targetPath>
        <excludes>
          <!-- Only the minified build is used at runtime; dev, esm and source-maps are not needed in the JAR -->
          <exclude>resources/lib/monaco-editor/dev/**</exclude>
          <exclude>resources/lib/monaco-editor/esm/**</exclude>
          <exclude>resources/lib/monaco-editor/min-maps/**</exclude>
        </excludes>
      </resource>
      <resource>
        <directory>.</directory>
        <includes>
          <include>plugin.xml</include>
        </includes>
      </resource>
    </resources>

    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-clean-plugin</artifactId>
          <version>3.3.2</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-resources-plugin</artifactId>
          <version>3.3.1</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-compiler-plugin</artifactId>
          <version>3.13.0</version>
          <configuration>
            <annotationProcessorPaths>
              <path>
                <groupId>org.projectlombok</groupId>
                <artifactId>lombok</artifactId>
                <version>1.18.42</version>
              </path>
            </annotationProcessorPaths>
          </configuration>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-surefire-plugin</artifactId>
          <version>3.2.5</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-jar-plugin</artifactId>
          <version>3.3.0</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-install-plugin</artifactId>
          <version>3.1.1</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-deploy-plugin</artifactId>
          <version>3.1.1</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-release-plugin</artifactId>
          <version>3.0.1</version>
          <configuration>
            <tagNameFormat>v@{project.version}</tagNameFormat>
            <autoVersionSubmodules>true</autoVersionSubmodules>
            <releaseProfiles>release</releaseProfiles>
          </configuration>
        </plugin>
        <plugin>
          <groupId>org.eclipse.transformer</groupId>
          <artifactId>transformer-maven-plugin</artifactId>
          <version>1.0.0</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-antrun-plugin</artifactId>
          <version>3.1.0</version>
        </plugin>
      </plugins>
    </pluginManagement>

    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <version>3.4.1</version>
        <executions>
          <execution>
            <id>enforce-versions</id>
            <goals>
              <goal>enforce</goal>
            </goals>
            <configuration>
              <rules>
                <requireJavaVersion>
                  <version>[21,)</version>
                </requireJavaVersion>
                <requireMavenVersion>
                  <version>[3.8,)</version>
                </requireMavenVersion>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <configuration>
          <archive>
            <manifestEntries>
              <Bundle-ManifestVersion>2</Bundle-ManifestVersion>
              <Bundle-Name>${project.name}</Bundle-Name>
              <Bundle-SymbolicName>${project.groupId}.${project.artifactId};singleton:=true</Bundle-SymbolicName>
              <Bundle-Version>${manifest.version}</Bundle-Version>
              <Bundle-Vendor>${project.organization.name}</Bundle-Vendor>
              <Require-Bundle>com.polarion.portal.tomcat,com.polarion.platform.persistence,org.apache.hivemind,com.polarion.alm.ui;bundle-version="${polarion.version}",com.polarion.alm.tracker;bundle-version="${polarion.version}",com.polarion.core.util;bundle-version="${polarion.version}",com.polarion.platform.repository;bundle-version="${polarion.version}",com.polarion.platform;bundle-version="${polarion.version}",org.eclipse.core.runtime,com.polarion.psvn.launcher,com.google.gson</Require-Bundle>
              <Import-Package>org.apache.log4j</Import-Package>
              <!-- The editor webapp is contributed via plugin.xml with
                   contextRoot="src/main/webapp". Polarion/Tomcat can only mount a
                   plugin webapp when that contextRoot is a real directory on disk
                   (a JAR'd bundle keeps it inside the archive, so the context never
                   mounts on Polarion 2606 / Tomcat 11). Mark the bundle dir-shaped,
                   like the core webapp plugins (e.g. com.polarion.alm.wiki), so it
                   is installed exploded. -->
              <Eclipse-BundleShape>dir</Eclipse-BundleShape>
            </manifestEntries>
          </archive>
        </configuration>
      </plugin>
      <plugin>
        <!-- Mockito requires open modules for reflection under Java 21+ -->
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <argLine>
            -XX:+EnableDynamicAgentLoading
            --add-opens java.base/java.lang=ALL-UNNAMED
            --add-opens java.base/java.util=ALL-UNNAMED
            --add-opens java.base/java.lang.reflect=ALL-UNNAMED
          </argLine>
        </configuration>
      </plugin>
      <!--
        Rewrites the javax.servlet bytecode (and, via the text-master override,
        WEB-INF/web.xml) of the plain maven-jar-plugin output to jakarta.servlet /
        Servlet 6.1, producing a classified sibling jar. <bundles>-</bundles> keeps
        Bundle-SymbolicName/Bundle-Name identical to the javax jar — the 2606 jar
        must keep the same plugin identity as the pre2606 one.
      -->
      <plugin>
        <groupId>org.eclipse.transformer</groupId>
        <artifactId>transformer-maven-plugin</artifactId>
        <configuration>
          <rules>
            <jakartaDefaults>true</jakartaDefaults>
            <bundles>-</bundles>
            <texts>
              <text>${project.basedir}/src/main/transformer/text-master.properties</text>
            </texts>
          </rules>
          <classifier>polarion2606</classifier>
          <artifact>
            <groupId>${project.groupId}</groupId>
            <artifactId>${project.artifactId}</artifactId>
          </artifact>
        </configuration>
        <executions>
          <execution>
            <id>jakarta-2606-jar</id>
            <phase>package</phase>
            <goals>
              <goal>jar</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
      <!--
        The jakarta build above becomes the default (no-classifier) artifact and
        the plain javax build becomes the -pre2606 legacy artifact, by simply
        renaming the two files already produced in target/ — see the DUAL-PLATFORM
        BUILD note in <properties> above for why. Must run after the transformer
        execution (declaration order within the same phase). This rename is
        package-phase-terminal: do not run "mvn install"/"mvn deploy" after it in
        the same build, since the transformer's attached -polarion2606 artifact
        file no longer exists once this step moves it.
      -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-antrun-plugin</artifactId>
        <executions>
          <execution>
            <id>swap-default-to-jakarta</id>
            <phase>package</phase>
            <goals>
              <goal>run</goal>
            </goals>
            <configuration>
              <target>
                <move file="${project.build.directory}/${project.build.finalName}.jar"
                      tofile="${project.build.directory}/${project.build.finalName}-pre2606.jar"/>
                <move file="${project.build.directory}/${project.build.finalName}-polarion2606.jar"
                      tofile="${project.build.directory}/${project.build.finalName}.jar"/>
              </target>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

  <dependencies>

    <!-- ===== Polarion Platform (provided by OSGi runtime) ===== -->
    <dependency>
      <groupId>com.polarion</groupId>
      <artifactId>platform</artifactId>
      <version>${polarion.version}</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>com.polarion</groupId>
      <artifactId>alm.projects</artifactId>
      <version>${polarion.version}</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>com.polarion</groupId>
      <artifactId>platform.persistence</artifactId>
      <version>${polarion.version}</version>
      <scope>provided</scope>
    </dependency>
    <!-- Polarion bundles are "exploded": their implementation classes live in an
         embedded jar that the mirror publishes as a separate artifact
         com.polarion:<bundle>.<embedded-jar>. The com.polarion.platform.persistence.*
         classes (e.g. UnresolvableObjectException) are in this embedded jar, not in
         the platform.persistence bundle wrapper above. -->
    <dependency>
      <groupId>com.polarion</groupId>
      <artifactId>platform.persistence.platform-persistence</artifactId>
      <version>${polarion.version}</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>com.polarion</groupId>
      <artifactId>platform.repository</artifactId>
      <version>${polarion.version}</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>com.polarion</groupId>
      <artifactId>alm.ui</artifactId>
      <version>${polarion.version}</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>com.polarion</groupId>
      <artifactId>alm.tracker</artifactId>
      <version>${polarion.version}</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>com.polarion</groupId>
      <artifactId>core.util</artifactId>
      <version>${polarion.version}</version>
      <scope>provided</scope>
    </dependency>
    <!-- Subterra base bundle (OSGi bundle com.polarion.subterra.base). It is a
         single bundle in the mirror and provides every com.polarion.subterra.base.*
         package the plugin uses (base.location.*, base.data.identification.*, …).
         (The old Avasis registry split it into synthetic subterra.base.data /
         subterra.base.core artifacts, which do not exist in our own mirror.) -->
    <dependency>
      <groupId>com.polarion</groupId>
      <artifactId>subterra.base</artifactId>
      <version>${subterra.version}</version>
      <scope>provided</scope>
    </dependency>
    <!-- Embedded jar of the subterra.base bundle (see note above): provides the
         com.polarion.subterra.base.data.* packages, e.g.
         com.polarion.subterra.base.data.identification.IContextId. -->
    <dependency>
      <groupId>com.polarion</groupId>
      <artifactId>subterra.base.subterra-base-data</artifactId>
      <version>${subterra.version}</version>
      <scope>provided</scope>
    </dependency>

    <!-- ===== Servlet API (provided by Polarion / Tomcat) =====
         Source compiles against javax.servlet only; transformer-maven-plugin
         rewrites the compiled bytecode to jakarta.servlet for the 2606 jar
         (see the DUAL-PLATFORM BUILD note in <properties> above). -->
    <dependency>
      <groupId>javax.servlet</groupId>
      <artifactId>javax.servlet-api</artifactId>
      <version>3.1.0</version>
      <scope>provided</scope>
    </dependency>

    <!-- ===== Third-party (provided by OSGi runtime) ===== -->
    <dependency>
      <groupId>com.google.code.gson</groupId>
      <artifactId>gson</artifactId>
      <version>2.10.1</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>org.apache.logging.log4j</groupId>
      <artifactId>log4j-api</artifactId>
      <version>2.20.0</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>org.apache.logging.log4j</groupId>
      <artifactId>log4j-core</artifactId>
      <version>2.20.0</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>velocity-tools</groupId>
      <artifactId>velocity-tools</artifactId>
      <version>1.4</version>
      <scope>provided</scope>
    </dependency>

    <!-- ===== Code generation (compile-time only) ===== -->
    <dependency>
      <groupId>org.projectlombok</groupId>
      <artifactId>lombok</artifactId>
      <version>1.18.42</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>org.jetbrains</groupId>
      <artifactId>annotations</artifactId>
      <version>24.1.0</version>
      <scope>provided</scope>
    </dependency>

    <!-- ===== Test ===== -->
    <dependency>
      <groupId>junit</groupId>
      <artifactId>junit</artifactId>
      <version>4.13.2</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.mockito</groupId>
      <artifactId>mockito-core</artifactId>
      <version>5.11.0</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>javax.transaction</groupId>
      <artifactId>jta</artifactId>
      <version>1.1</version>
      <scope>test</scope>
    </dependency>

  </dependencies>

</project>
